# Port the Express server should listen on (Render automatically provides PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster address with your own from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_db?retryWrites=true&w=majority

# Frontend URL allowed by CORS (use http://localhost:5173 for local dev, or your Netlify URL in production)
FRONTEND_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
