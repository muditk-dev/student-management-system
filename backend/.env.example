# Port the Express server should listen on (Render automatically provides PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Replace <password> with the password configured for edupulse_app
MONGODB_URI=mongodb+srv://edupulse_app:<password>@cluster0.m4s4rqe.mongodb.net/student_mgmt_db?retryWrites=true&w=majority

